@@ -86,6 +86,8 @@ resource "local_file" "web_app_wrangler_production" {
     [[services]]
     binding = "CONTROL_PLANE_WORKER"
     service = "open-inspect-control-plane-${local.name_suffix}"
+
+    ${local.web_app_custom_domain_block}
   TOML
 }
 

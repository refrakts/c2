@@ -0,0 +1,28 @@
+import { describe, expect, it } from "vitest";
+import { parseInstallationMap, resolveInstallationId } from "./installation-map";
+
+describe("parseInstallationMap", () => {
+  it("returns an empty map for missing or invalid JSON", () => {
+    expect(parseInstallationMap(undefined).size).toBe(0);
+    expect(parseInstallationMap("not json").size).toBe(0);
+  });
+
+  it("lowercases keys and ignores non-string values", () => {
+    const map = parseInstallationMap('{"Acme":"123","bad":456}');
+
+    expect(map.get("acme")).toBe("123");
+    expect(map.has("bad")).toBe(false);
+  });
+});
+
+describe("resolveInstallationId", () => {
+  it("falls back to the default installation for an empty map", () => {
+    expect(resolveInstallationId("acme", new Map(), "999")).toBe("999");
+  });
+
+  it("matches owners case-insensitively", () => {
+    const map = parseInstallationMap('{"acme":"123"}');
+
+    expect(resolveInstallationId("Acme", map, "999")).toBe("123");
+  });
+});
diff --git a/packages/shared/src/github/installation-map.ts b/packages/shared/src/github/installation-map.ts

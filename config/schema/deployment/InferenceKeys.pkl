module InferenceKeys

class InferenceKeys {
  /// Anthropic API key for Claude
  anthropic: String(startsWith("sk-ant-"))

  /// OpenCode API key for Zen/Go
  opencode: String(startsWith("sk-"))?

  /// Google AI Studio API key for Gemini models
  googleAiStudio: String(startsWith("AIza"))?

  /// Firecrawl API key for web scraping and search
  firecrawl: String(startsWith("fc-"))?
}

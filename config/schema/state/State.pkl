open module State

class State {
  region: String(length > 0)

  bucket: String(length > 0)
  accountId: String(length > 0)

  accessKey: String(length > 0)
  secretKey: String(length > 0)

  coreKey: String(length > 0) = "production/terraform.tfstate"
  mobileKey: String(length > 0) = "mobile/terraform.tfstate"
}

open module Project

class Project {
  /// Submodule path relative to repo root (also where the work_dir name comes from)
  source: String(length > 0)

  /// SHA pinned in config.example.pkl — preflight enforces this
  pin: String(length == 40)

  /// Whether patches in patches/<name>/ should be applied to this project
  patches: Boolean = false

  /// Optional tweakcn/shadcn registry theme URL to apply after patches sync
  tweakcnThemeUrl: String(matches(Regex(#"^https://tweakcn\.com/r/themes/[a-z0-9-]+\.json$"#)))? = null
}

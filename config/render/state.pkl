/// Renders the `state` block from config.pkl to deploy/state.json.
/// Consumed by Ansible (04-terraform-init.yml) to render per-project
/// backend.tfvars files for terraform init.

@ModuleInfo { minPklVersion = "0.31.0" }
module State

import "../../config.pkl" as c
local s = c.state

region     = s.region
bucket     = s.bucket
account_id = s.accountId
access_key = s.accessKey
secret_key = s.secretKey
core_key   = s.coreKey
mobile_key = s.mobileKey
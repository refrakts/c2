/// Renders the `state` block from config.pkl to deploy/state.json.
/// Consumed by deploy/_shared/backend.hcl for the Terragrunt R2 backend.

@ModuleInfo { minPklVersion = "0.31.0" }
module State

import "../../config.pkl" as c
local s = c.state

region     = s.region
bucket     = s.bucket
account_id = s.accountId
access_key = s.accessKey
secret_key = s.secretKey
passphrase = s.passphrase

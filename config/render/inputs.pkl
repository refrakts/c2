@ModuleInfo { minPklVersion = "0.31.0" }
module Inputs

import "../../config.pkl" as c
local d = c.deployment

// ─── Always-present fields ──────────────────────────────────────────────
local baseFields = new Mapping {
  // Cloudflare
  ["cloudflare_api_token"] = d.cloudflare.apiToken
  ["cloudflare_account_id"] = d.cloudflare.accountId
  ["cloudflare_worker_subdomain"] = d.cloudflare.workerSubdomain
  ["cloudflare_zone_id"] = d.cloudflare.zoneId

  // GitHub App (required — used for OAuth even when bot disabled)
  ["github_client_id"] = d.github.app.clientId
  ["github_client_secret"] = d.github.app.clientSecret
  ["github_app_id"] = d.github.app.appId
  ["github_app_installation_id"] = d.github.app.installationId
  ["github_app_installation_map"] = d.github.app.installations
  ["github_app_private_key"] = d.github.app.privateKey

  // API keys
  ["anthropic_api_key"] = d.inferenceKeys.anthropic
  ["opencode_api_key"] = d.inferenceKeys.opencode
  ["google_ai_studio_api_key"] = d.inferenceKeys.googleAiStudio

  // Security
  ["token_encryption_key"] = d.security.tokenEncryptionKey
  ["repo_secrets_encryption_key"] = d.security.repoSecretsEncryptionKey
  ["internal_callback_secret"] = d.security.internalCallbackSecret
  ["nextauth_secret"] = d.security.nextauthSecret

  // Config
  ["sandbox_provider"] = d.sandboxProvider
  ["web_platform"] = d.webPlatform
  ["deployment_name"] = d.name
  ["app_name"] = d.appName
  ["app_short_name"] = d.appShortName
  ["app_icon_url"] = d.appIconUrl
  ["custom_web_app_domain"] = d.appDomain
  ["r2_media_bucket_name"] = d.r2MediaBucketName

  // Access control — upstream expects comma-separated strings; convert from lists
  ["allowed_users"] = d.accessControl.allowedUsers.join(",")
  ["allowed_email_domains"] = d.accessControl.allowedEmailDomains.join(",")
  ["unsafe_allow_all_users"] = d.accessControl.unsafeAllowAllUsers
}

// ─── Conditional sections ───────────────────────────────────────────────

local vercelFields: Mapping<String, Any> =
  if (d.vercel != null)
    new Mapping {
      ["vercel_api_token"] = d.vercel.apiToken
      ["vercel_team_id"] = d.vercel.teamId
    }
  else
    new Mapping {}

local modalFields: Mapping<String, Any> =
  if (d.modal != null)
    new Mapping {
      ["modal_token_id"] = d.modal.tokenId
      ["modal_token_secret"] = d.modal.tokenSecret
      ["modal_workspace"] = d.modal.workspace
      ["modal_api_secret"] = d.modal.apiSecret
    }
  else
    new Mapping {}

local daytonaFields: Mapping<String, Any> =
  if (d.daytona != null)
    new Mapping {
      ["daytona_api_url"] = d.daytona.apiUrl
      ["daytona_api_key"] = d.daytona.apiKey
      ["daytona_base_snapshot"] = d.daytona.baseSnapshot
    }
  else
    new Mapping {}

local githubBotFields: Mapping<String, Any> =
  if (d.github.bot != null && d.github.bot.enabled)
    new Mapping {
      ["enable_github_bot"] = true
      ["github_webhook_secret"] = d.github.bot.webhookSecret
      ["github_bot_username"] = d.github.bot.username
    }
  else
    new Mapping {
      ["enable_github_bot"] = false
    }

local slackFields: Mapping<String, Any> =
  if (d.slack != null && d.slack.enabled)
    new Mapping {
      ["enable_slack_bot"] = true
      ["slack_bot_token"] = d.slack.botToken
      ["slack_signing_secret"] = d.slack.signingSecret
    }
  else
    new Mapping {
      ["enable_slack_bot"] = false
    }

local linearFields: Mapping<String, Any> =
  if (d.linear != null && d.linear.enabled)
    new Mapping {
      ["enable_linear_bot"] = true
      ["linear_client_id"] = d.linear.clientId
      ["linear_client_secret"] = d.linear.clientSecret
      ["linear_webhook_secret"] = d.linear.webhookSecret
    }
  else
    new Mapping {
      ["enable_linear_bot"] = false
    }

// ─── Merge everything into the output ────────────────────────────────────
output {
  value =
    (
      baseFields.toMap()
        + vercelFields.toMap()
        + modalFields.toMap()
        + daytonaFields.toMap()
        + githubBotFields.toMap()
        + slackFields.toMap()
        + linearFields.toMap()
    ).toMapping()

  renderer = new JsonRenderer {}
}
